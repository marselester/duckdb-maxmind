# name: test/sql/maxmind.test
# group: [maxmind]

require maxmind

# read_mmdb table function.

query I
SELECT city.names.en FROM read_mmdb('./test-data/test-data/GeoIP2-City-Test.mmdb') WHERE city.names.en = 'Boxford' LIMIT 1;
----
Boxford

query I
SELECT city.names.en FROM read_mmdb('./test-data/test-data/GeoIP2-City-Test.mmdb', network='89.160.20.0/24') LIMIT 1;
----
Linköping

query I
SELECT city.names.en FROM read_mmdb('./test-data/test-data/GeoIP2-City-Test.mmdb', network=NULL) WHERE city.names.en = 'Boxford' LIMIT 1;
----
Boxford

query I
SELECT country.names.en FROM read_mmdb('./test-data/test-data/GeoIP2-City-Test.mmdb', network='2001:218::/24') LIMIT 1;
----
Japan

query I
SELECT count(*) FROM read_mmdb('./test-data/test-data/GeoIP2-City-Test.mmdb');
----
250

query I
SELECT network FROM read_mmdb('./test-data/test-data/GeoIP2-City-Test.mmdb', network='89.160.20.0/24') LIMIT 1;
----
89.160.20.112/28

query II
SELECT country.iso_code, city.names.en FROM read_mmdb('./test-data/test-data/GeoIP2-City-Test.mmdb', network='89.160.20.128/25');
----
SE	Linköping

query II
SELECT count(*), count(isp) FROM read_mmdb('./test-data/test-data/GeoIP2-ISP-Test.mmdb');
----
2129	2129

query II
SELECT sum(location.accuracy_radius), count(location.accuracy_radius) FROM read_mmdb('./test-data/test-data/GeoIP2-City-Test.mmdb');
----
26492	250

# read_mmdb: include_empty parameter.

query I
SELECT count(*) FROM read_mmdb('./test-data/test-data/GeoIP2-Anonymous-IP-Test.mmdb');
----
12

query I
SELECT count(*) FROM read_mmdb('./test-data/test-data/GeoIP2-Anonymous-IP-Test.mmdb', include_empty=true);
----
599

query I
SELECT count(*) FROM read_mmdb('./test-data/test-data/GeoIP2-Anonymous-IP-Test.mmdb', include_empty=false);
----
12

query I
SELECT count(*) FROM read_mmdb('./test-data/test-data/GeoIP2-Anonymous-IP-Test.mmdb', network='1.0.0.0/8', include_empty=true);
----
31

query I
SELECT count(*) FROM read_mmdb('./test-data/test-data/GeoIP2-Anonymous-IP-Test.mmdb', network='1.0.0.0/8', include_empty=false);
----
2

# read_mmdb: unknown database type returns JSON.

query I
SELECT count(*) FROM read_mmdb('./test-data/test-data/MaxMind-DB-test-mixed-24.mmdb');
----
11

query II
SELECT network, record FROM read_mmdb('./test-data/test-data/MaxMind-DB-test-mixed-24.mmdb') LIMIT 1;
----
1.1.1.1/32	{"ip":"::1.1.1.1"}

query I
SELECT network FROM read_mmdb('./test-data/test-data/MaxMind-DB-test-mixed-24.mmdb') LIMIT 1;
----
1.1.1.1/32

query I
SELECT record FROM read_mmdb('./test-data/test-data/MaxMind-DB-test-mixed-24.mmdb') LIMIT 1;
----
{"ip":"::1.1.1.1"}

query I
SELECT record FROM read_mmdb('./test-data/test-data/MaxMind-DB-test-mixed-24.mmdb', network='1.1.1.1/32') LIMIT 1;
----
{"ip":"::1.1.1.1"}

query I
SELECT count(*) FROM read_mmdb('./test-data/test-data/MaxMind-DB-test-mixed-24.mmdb', include_empty=true);
----
11

query I
SELECT length(record) FROM read_mmdb('./test-data/test-data/MaxMind-DB-test-decoder-value-limit.mmdb') LIMIT 1;
----
131071

# read_mmdb: edge cases.

statement error
SELECT * FROM read_mmdb('./nonexistent.mmdb') LIMIT 1;
----
FileNotFound

statement error
SELECT * FROM read_mmdb('./test-data/test-data/GeoIP2-City-Test.mmdb', network='invalid') LIMIT 1;
----
parsing network

statement error
SELECT * FROM read_mmdb(NULL) LIMIT 1;
----
path must not be NULL

statement error
SELECT count(*) FROM read_mmdb('./test-data/test-data/MaxMind-DB-test-broken-search-tree-24.mmdb');
----
InvalidTreeNode

statement error
SELECT location FROM read_mmdb('./test-data/test-data/GeoIP2-City-Test-Broken-Double-Format.mmdb');
----
InvalidDoubleSize

# Typed scalar functions (one per database type).

query I
SELECT geolite_city('./test-data/test-data/GeoIP2-City-Test.mmdb', '89.160.20.128', '').city.names.en;
----
Linköping

query I
SELECT geolite_city('./test-data/test-data/GeoIP2-City-Test.mmdb', '2001:218::', '').country.names.en;
----
Japan

query I
SELECT geolite_city('./test-data/test-data/GeoIP2-City-Test.mmdb', '89.160.20.128', '').network;
----
89.160.20.128/25

query I
SELECT geolite_city('./test-data/test-data/GeoIP2-City-Test.mmdb', '2001:218::', '').network;
----
2001:0218:0000:0000:0000:0000:0000:0000/32

query I
SELECT geolite_city('./test-data/test-data/GeoIP2-City-Test.mmdb', '89.160.20.128', 'city').network;
----
89.160.20.128/25

query I
SELECT geolite_city('./test-data/test-data/GeoIP2-City-Test.mmdb', '89.160.20.128', 'city').city.names.en;
----
Linköping

query I
SELECT geolite_city('./test-data/test-data/GeoIP2-City-Test.mmdb', '89.160.20.128', 'city,country');
----
{'network': 89.160.20.128/25, 'city': {'geoname_id': 2694762, 'names': {de=Linköping, en=Linköping, fr=Linköping, ja=リンシェーピング, zh-CN=林雪平}}, 'continent': {'code': '', 'geoname_id': 0, 'names': NULL}, 'country': {'geoname_id': 2661886, 'is_in_european_union': true, 'iso_code': SE, 'names': {de=Schweden, en=Sweden, es=Suecia, fr=Suède, ja=スウェーデン王国, pt-BR=Suécia, ru=Швеция, zh-CN=瑞典}}, 'location': {'accuracy_radius': 0, 'latitude': NULL, 'longitude': NULL, 'time_zone': ''}, 'postal': {'code': ''}, 'registered_country': {'geoname_id': 0, 'is_in_european_union': false, 'iso_code': '', 'names': NULL}, 'represented_country': {'geoname_id': 0, 'is_in_european_union': false, 'iso_code': '', 'names': NULL, 'type': ''}, 'subdivisions': NULL}

